# Copiar como .env y rellenar. El archivo .env NO se sube a GitHub.

# Dirección del sitio: IP fija de la máquina virtual en el servidor; "localhost" en desarrollo.
SITE_ADDRESS=192.168.1.50

# IP fija del equipo de administración (panel de PocketBase y rutas de administración).
# En desarrollo con Docker Desktop: 0.0.0.0/0 (todas las IPs, porque el equipo local es el administrador).
ADMIN_IP=192.168.1.10

# Modo del WAF: DetectionOnly al implantar; On (bloqueo) antes de la prueba con usuarios.
WAF_MODO=DetectionOnly

# Migraciones de PocketBase: servidor -> ro y false; desarrollo -> rw y true.
PB_MIGRATIONS_MODO=ro
PB_AUTOMIGRATE=false

# Clave del bouncer de CrowdSec. Generar con: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# Carpeta del disco de copias montado en el servidor (en desarrollo: ./copias-local).
DISCO_COPIAS=/srv/copias
